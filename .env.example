# ==============================================================================
# Rewind Bot Environment Configuration
# ==============================================================================

# Project General
PROJECT_NAME=rewind
ENVIRONMENT=development  # 'development' | 'production' | 'test'
DEBUG=true
LOG_LEVEL=INFO           # 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'

# Telegram Bot Settings
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=RewindChatBot
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_a_secure_random_token
ADMIN_USER_IDS=7728111589

# Database Configuration
# For PostgreSQL (Production / Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rewind_db
# For SQLite (Local Testing without Postgres):
# DATABASE_URL=sqlite+aiosqlite:///./rewind.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379/0

# Storage Settings (Local Disk or S3-compatible Storage)
STORAGE_TYPE=local  # 'local' or 's3'
LOCAL_STORAGE_DIR=./data/media
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=rewind-media-archive
S3_REGION=us-east-1

# Security & Data Encryption
ENCRYPTION_KEY=replace_with_32_characters_key_here!

# Business Logic & Retention Settings
TRIAL_HOURS=72
PRO_SUBSCRIPTION_STARS=50
PRO_SUBSCRIPTION_PERIOD_DAYS=30
MEDIA_RETENTION_DAYS=30
